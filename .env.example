# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://drishti:drishti_secret@localhost:5432/drishti

# ─── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=drishti_neo4j

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=drishti_minio
MINIO_SECRET_KEY=drishti_minio_secret
MINIO_BUCKET=drishti-evidence
MINIO_USE_SSL=false

# ─── JWT (Mock Auth — no Keycloak required) ──────────────────────────────────
JWT_SECRET=drishti_jwt_super_secret_hackathon_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Ollama (Self-hosted LLM) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Service Ports ───────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
CASE_SERVICE_PORT=3002
PEOPLE_SERVICE_PORT=3003
UNIT_SERVICE_PORT=3004
EVIDENCE_SERVICE_PORT=3005
ALERT_SERVICE_PORT=3006
AUDIT_SERVICE_PORT=3007
TASK_SERVICE_PORT=3008
DIGEST_SERVICE_PORT=3009
ADMIN_SERVICE_PORT=3010
PERFORMANCE_SERVICE_PORT=3011
REPORT_SERVICE_PORT=3012

NLQ_SERVICE_PORT=8001
EMBEDDING_SERVICE_PORT=8002
ANOMALY_SERVICE_PORT=8003
GRAPH_SERVICE_PORT=8004
XAI_SERVICE_PORT=8005
FACE_SERVICE_PORT=8006
CCTV_SERVICE_PORT=8007
VEHICLE_SERVICE_PORT=8008
STT_SERVICE_PORT=8009
FORECAST_SERVICE_PORT=8010
NARRATIVE_SERVICE_PORT=8011
INTAKE_SERVICE_PORT=8012
COPILOT_SERVICE_PORT=8013

# ─── Rate Limits ─────────────────────────────────────────────────────────────
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AI=20
RATE_LIMIT_EVIDENCE_UPLOAD=10

# ─── Max file upload size (MB) ────────────────────────────────────────────────
MAX_EVIDENCE_FILE_MB=100

# ─── Confidence thresholds ───────────────────────────────────────────────────
NARRATIVE_CONFIDENCE_THRESHOLD=0.6
SIMILARITY_DEFAULT_THRESHOLD=0.7
VOICE_CONFIDENCE_THRESHOLD=0.6

# ─── Anomaly engine ──────────────────────────────────────────────────────────
ANOMALY_BASELINE_WINDOW_DAYS=90
ANOMALY_ZSCORE_THRESHOLD=2.5

# ─── Forecast ────────────────────────────────────────────────────────────────
FORECAST_DEFAULT_HORIZON_DAYS=30

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
